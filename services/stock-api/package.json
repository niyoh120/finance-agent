{
  "name": "stock-api",
  "version": "1.0.0",
  "description": "TradingView Stock Price API Wrapper",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint --cache --max-warnings=0 \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint --cache --fix --max-warnings=0 \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write --ignore-unknown \"src/**/*.{ts,tsx,js,json,yml,yaml}\""
  },
  "dependencies": {
    "@mathieuc/tradingview": "^3.5.2",
    "fastify": "^4.26.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.46.1"
  }
}
