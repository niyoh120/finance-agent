models:
    default:
        provider: "gemini"
        model_id: "gemini-3-flash"
    # 你可以为不同的智能体指定不同的模型
    # technical:
    #     provider: "gemini"
    #     model_id: "gemini-1.5-pro"
    # options:
    #     provider: "gemini"
    #     model_id: "gemini-1.5-pro"

mcp_server:
    # MCP Server 的地址，支持环境变量
    url: "${FA_MCP_SERVER_URL:-http://localhost:8000/mcp}"

stock_api:
    # 股票历史数据 API 地址，支持环境变量
    url: "${FA_STOCK_API_URL:-http://localhost:8000/api}"

storage:
    # 本地 SQLite 数据库路径，用于存储工作流会话
    sqlite_db_path: "./data/trade_agent.db"

risk_parameters:
    max_portfolio_volatility: 0.15
    var_confidence: 0.95
    volatility_lookback_days: 60
    max_position_limit: 0.2

analysis:
    timeframe: "D"
    history_range: 365
    # 不同分析信号的初始权重（仅供参考，决策由组合经理智能体做出）
    signal_weights:
        technical: 0.25
        options: 0.25
        wyckoff: 0.3
        fundamental: 0.15
        sentiment: 0.05

discord_bot:
    # 机器人并发与超时
    max_concurrency: 3
    run_timeout_seconds: 180

    # Team 会话记忆（thread 共享）
    session_user_mode: "thread_shared" # thread_shared | author
    session_id_prefix: "discord"
    enable_session_summaries: true
    add_session_summary_to_context: true
    add_history_to_context: true
    thread_history_on_session_hit: false
    bootstrap_thread_history_messages: null
    num_history_runs: 3

    # 工具输出压缩（可选）
    compress_tool_results: false
    compress_token_limit: null

    # thread 历史上下文（thread-only 模式）
    thread_history_messages: 20
    thread_history_max_chars: 3000
    thread_history_include_bots: false

    # 流式事件控制（建议保持 false，避免噪音）
    stream_events: false
    stream_member_events: false
    include_reasoning: false

    # Discord 输出行为
    typing_indicator_enabled: true
    min_edit_interval_ms: 700
    min_edit_chars: 24
    max_stream_chars: 1800
    max_final_chars: 1900
    final_overflow_strategy: "split" # split | truncate
    render_mode: "auto" # auto | markdown | embed
    buttons_enabled: true
    button_full_text_max_chars: 10000
