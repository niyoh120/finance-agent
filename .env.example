############################
# Finance Agent .env 示例
############################

# 通用 / shared
FA_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/finance
FA_SQL_ECHO=false
FA_LOG_LEVEL=INFO

# Macro Scraper (services/macro-scraper)
FA_MACRO_SCRAPER_BASE_URL=https://macro-dashboard-backend-f0x7.onrender.com/api/v1
FA_MACRO_SCRAPER_POLL_INTERVAL=3600
FA_MACRO_SCRAPER_HISTORY_DAYS=365
FA_MACRO_SCRAPER_ENABLE_PROTECTED_ENDPOINTS=false

# Options Scraper (services/options-scraper)
# 注意：这里使用的是 Discord user token，不是 bot token；存在违反 Discord ToS 的风险。
FA_OPTIONS_SCRAPER_DISCORD_TOKEN=
FA_OPTIONS_SCRAPER_CHANNEL_ID=
FA_OPTIONS_SCRAPER_POLL_INTERVAL=300
FA_OPTIONS_SCRAPER_START_DATE=2025-12-01

# 可选：按服务覆盖日志级别（优先级高于 FA_LOG_LEVEL）

# Options Dashboard (services/options-dashboard)
# ConvexValue Research Plan API key。接管期权链、历史期权 OHLCV、FMP 财务/财报/利率数据。
CV_API_KEY=
# 可选：进程内缓存 TTL（秒），默认期权链 60s、历史 24h。
# OD_CHAIN_TTL_SECONDS=60
# 可选：Streamlit 服务端口，默认 8501。
# OD_PORT=8501
