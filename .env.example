############################
# Finance Agent .env 示例
############################

# 通用 / shared
FA_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/finance
FA_SQL_ECHO=false
FA_LOG_LEVEL=INFO

# Stock API (services/stock-api)
FA_STOCK_API_PORT=3000
FA_STOCK_API_TV_SESSION=
FA_STOCK_API_TV_SIGNATURE=

# Stock Scraper (services/stock-scraper)
FA_STOCK_SCRAPER_API_URL=http://stock-api:3000
FA_STOCK_SCRAPER_CONFIG_PATH=services/stock-scraper/config.yaml
FA_STOCK_SCRAPER_POLL_INTERVAL=300

# Options Scraper (services/options-scraper)
FA_OPTIONS_SCRAPER_DISCORD_TOKEN=your_discord_user_token_here
FA_OPTIONS_SCRAPER_CHANNEL_ID=your_channel_id_here
FA_OPTIONS_SCRAPER_POLL_INTERVAL=300
# 格式: YYYY-MM-DD
FA_OPTIONS_SCRAPER_START_DATE=2025-12-01

# News Scraper (services/news-scraper)
FA_NEWS_SCRAPER_INTERVAL=60

# MCP Server (services/mcp-server)
FA_MCP_SERVER_STOCK_API_URL=http://stock-api:3000

# Admin (services/admin)
FA_ADMIN_HOST=0.0.0.0
FA_ADMIN_PORT=8000
FA_ADMIN_ROOT_PATH=
FA_ADMIN_FORWARDED_ALLOW_IPS=

# Wyckoff Agent (services/wyckoff-agent)
FA_WYCKOFF_OPENAI_BASE_URL=https://api.openai.com/v1
FA_WYCKOFF_OPENAI_API_KEY=
FA_WYCKOFF_OPENAI_MODEL=gpt-4o
FA_WYCKOFF_MCP_COMMAND=uv
FA_WYCKOFF_MCP_ARGS=run python -m mcp_server.studio
FA_WYCKOFF_MCP_TIMEOUT=120

# 可选：按服务覆盖日志级别（优先级高于 FA_LOG_LEVEL）
# FA_WYCKOFF_LOG_LEVEL=DEBUG
