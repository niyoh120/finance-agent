[database]
# Used by finance-shared when reading cached options flow from PostgreSQL.
# Sensitive values can be injected from environment variables with ${NAME}.
url = "${FA_DATABASE_URL}"

[sources.baostock]
enabled = true
priority = 90

[sources.akshare]
enabled = true
priority = 70

[sources.tickflow]
enabled = true
priority = 105
api_key = "${TICKFLOW_API_KEY}"
# Optional: override the default API base URL
# base_url = "https://api.tickflow.org"

[sources.finnhub]
enabled = true
priority = 102
api_key = "${FINNHUB_API_KEY}"
# Optional: override the default API base URL
# base_url = "https://finnhub.io/api/v1"

[sources.futunn]
enabled = true
priority = 100

[sources.openbb]
enabled = true
priority = 50

[sources.schwab]
enabled = true
# schwab-api 服务地址（services/schwab-api）。占位符在环境变量未设置时展开为空，
# 此时该源自动禁用，路由回退 tdx/tickflow/CV，零成本。
base_url = "${SCHWAB_API_BASE_URL}"
# 可选：仅当 schwab-api 开启 FA_SCHWAB_API_KEY 鉴权时需一致。
api_key = "${SCHWAB_API_KEY}"

[sources.tdx]
enabled = true
# tdx-api 服务地址（services/tdx-api，默认 http://127.0.0.1:8011）。
# base_url 是服务根地址（内部自动追加 /api/v1）；占位符在环境变量未设置时
# 展开为空，此时 TDX 源自动禁用，港股/国际期货/SGE 等 TDX 独占路由回退失败。
# 启用顺序：先部署并健康检查 tdx-api，再设置 TDX_API_BASE_URL。
base_url = "${TDX_API_BASE_URL}"
# 可选：与服务端 FA_TDX_API_KEY 一致的共享密钥（X-API-Key 头；消费端
# 环境变量名为 TDX_API_KEY，与服务端变量名区分）。
api_key = "${TDX_API_KEY}"
