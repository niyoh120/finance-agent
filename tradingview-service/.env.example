# TradingView 环境变量示例
# 复制此文件为 .env 并填写配置

# 要订阅的股票代码列表 (逗号分隔)
# 格式: EXCHANGE:SYMBOL
# 示例: NASDAQ:AAPL,NASDAQ:GOOGL,NYSE:MSFT,BINANCE:BTCUSDT
TV_SYMBOLS=NASDAQ:AAPL,NASDAQ:GOOGL

# 时间粒度 (分钟)
# 支持: 1, 3, 5, 15, 30, 45, 60, 120, 180, 240, D, W, M
TV_TIMEFRAME=1

# 数据库路径 (可选，默认为 ./data/stock_prices.db)
# TV_DATABASE_PATH=./data/stock_prices.db

# TradingView 登录凭证 (可选，用于 Premium 功能)
# 从浏览器 Cookie 中获取 sessionid 和 sessionid_sign
# TV_SESSION=your_session_id
# TV_SIGNATURE=your_session_signature
